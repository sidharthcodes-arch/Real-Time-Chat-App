APP_NAME="Realtime Chat Test"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database: SQLite by default, zero setup. File lives at database/database.sqlite.
DB_CONNECTION=sqlite
# Switch to mysql/pgsql here if you prefer (not required):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# File-based session and cache so no extra DB tables are needed.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file

# Queue: how broadcast (and other) events are dispatched.
# 'sync' runs everything inline, no worker needed. Simplest while you get going.
# Switch to 'database' or 'redis' to exercise a real queue worker.
QUEUE_CONNECTION=sync

# =============================================================================
# BROADCASTING  <-- this is what the task is about. It is intentionally off.
# =============================================================================
# Default is empty (no real-time). Choose and configure a driver.
# Common options: reverb (first-party, self-hosted), pusher (managed),
# soketi (self-hosted, pusher-compatible).
BROADCAST_CONNECTION=

# If you choose Laravel Reverb, the server side uses these:
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST="localhost"
# REVERB_PORT=8080
# REVERB_SCHEME=http
#
# ...and the frontend uses these (note the VITE_ prefix, exposed to the browser):
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# If you choose Pusher instead:
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
# VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
